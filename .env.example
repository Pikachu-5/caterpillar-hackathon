# Backend-only configuration. No secrets belong in VITE_ variables.
APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8000
POSTGRES_DB=cat_operator_hub
POSTGRES_USER=cat_app
POSTGRES_PASSWORD=
DATABASE_URL=postgresql+psycopg://cat_app:SET_LOCAL_PASSWORD@localhost:5432/cat_operator_hub
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174
SESSION_COOKIE_NAME=cat_session
SESSION_COOKIE_SECURE=false
SESSION_TTL_HOURS=12
DEMO_ENABLED=true
TELEMETRY_HZ=5
PERSISTENCE_HZ=1
GEMINI_API_KEY=
GEMINI_MODEL=
AI_DAILY_BUDGET_USD=2
AI_MAX_REQUESTS_PER_DAY=100
AI_MAX_OUTPUT_TOKENS=800
WEATHER_MODE=demo
# Set real weather location explicitly. Synthetic map coordinates are not GPS.
WEATHER_LATITUDE=
WEATHER_LONGITUDE=
WEATHER_REFRESH_SECONDS=600
MANUAL_DIRECTORY=knowledge/raw
