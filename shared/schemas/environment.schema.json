{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.cat-operator-hub.example/v1/environment.schema.json",
  "title": "Environment",
  "type": "object",
  "properties": {
    "environment_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "weather_mode": {
      "type": "string",
      "enum": [
        "demo",
        "live"
      ]
    },
    "weather_status": {
      "type": "string",
      "enum": [
        "fresh",
        "stale",
        "unavailable"
      ]
    },
    "weather": {
      "$ref": "common.schema.json#/$defs/weather"
    },
    "air_temperature_c": {
      "anyOf": [
        {
          "type": "number",
          "minimum": -60,
          "maximum": 70
        },
        {
          "type": "null"
        }
      ]
    },
    "precipitation_mm_h": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "wind_speed_kmh": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "observed_at": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/timestamp"
        },
        {
          "type": "null"
        }
      ]
    },
    "fetched_at": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/timestamp"
        },
        {
          "type": "null"
        }
      ]
    },
    "weather_provider": {
      "type": "string",
      "enum": [
        "demo",
        "open_meteo"
      ]
    },
    "weather_code": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "location": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "latitude": {
              "type": "number",
              "minimum": -90,
              "maximum": 90
            },
            "longitude": {
              "type": "number",
              "minimum": -180,
              "maximum": 180
            }
          },
          "required": [
            "latitude",
            "longitude"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "soil_type": {
      "$ref": "common.schema.json#/$defs/soil_type"
    },
    "soil_moisture_percent_vwc": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/percent"
        },
        {
          "type": "null"
        }
      ]
    },
    "soil_source": {
      "type": "string",
      "enum": [
        "demo",
        "operator_input",
        "unknown"
      ]
    },
    "terrain": {
      "type": "string",
      "enum": [
        "firm",
        "mud",
        "sand",
        "rock",
        "unknown"
      ]
    },
    "extensions": {
      "$ref": "common.schema.json#/$defs/extensions"
    }
  },
  "required": [
    "environment_id",
    "weather_mode",
    "weather_status",
    "weather",
    "air_temperature_c",
    "precipitation_mm_h",
    "wind_speed_kmh",
    "observed_at",
    "fetched_at",
    "weather_provider",
    "weather_code",
    "location",
    "soil_type",
    "soil_moisture_percent_vwc",
    "soil_source",
    "terrain"
  ],
  "additionalProperties": false
}
