{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.cat-operator-hub.example/v1/historical-operation.schema.json",
  "title": "HistoricalOperation",
  "type": "object",
  "properties": {
    "timestamp": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2}:\\d{2}$"
    },
    "machine_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "operator_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "engine_hours": {
      "type": "number",
      "minimum": 0
    },
    "fuel_used_l": {
      "type": "number",
      "minimum": 0
    },
    "load_cycles": {
      "type": "integer",
      "minimum": 0
    },
    "idling_time_min": {
      "type": "number",
      "minimum": 0
    },
    "seatbelt_status": {
      "type": "string",
      "enum": [
        "Fastened",
        "Unfastened"
      ]
    },
    "safety_alert_triggered": {
      "type": "string",
      "enum": [
        "Yes",
        "No"
      ]
    },
    "provenance": {
      "type": "string",
      "enum": [
        "provided_sample",
        "synthetic"
      ]
    },
    "machine_model": {
      "const": "CAT 325"
    },
    "air_temperature_c": {
      "type": "number",
      "minimum": -60,
      "maximum": 70
    },
    "soil_type": {
      "$ref": "common.schema.json#/$defs/soil_type"
    },
    "soil_moisture_percent_vwc": {
      "$ref": "common.schema.json#/$defs/percent"
    },
    "interval_minutes": {
      "type": "number",
      "minimum": 0.001
    },
    "timezone": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "generator_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "generation_seed": {
      "type": "integer",
      "minimum": 0
    }
  },
  "required": [
    "timestamp",
    "machine_id",
    "operator_id",
    "engine_hours",
    "fuel_used_l",
    "load_cycles",
    "idling_time_min",
    "seatbelt_status",
    "safety_alert_triggered",
    "provenance"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "provenance": {
            "const": "synthetic"
          }
        },
        "required": [
          "provenance"
        ]
      },
      "then": {
        "required": [
          "generator_version",
          "generation_seed",
          "interval_minutes",
          "timezone",
          "machine_model"
        ],
        "properties": {
          "generator_version": {},
          "generation_seed": {},
          "interval_minutes": {},
          "timezone": {},
          "machine_model": {}
        }
      }
    }
  ]
}
