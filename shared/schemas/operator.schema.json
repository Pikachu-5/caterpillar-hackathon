{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.cat-operator-hub.example/v1/operator.schema.json",
  "title": "Operator",
  "type": "object",
  "properties": {
    "operator_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "username": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]{3,64}$"
    },
    "display_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "skill_level": {
      "$ref": "common.schema.json#/$defs/skill"
    },
    "created_at": {
      "$ref": "common.schema.json#/$defs/timestamp"
    }
  },
  "required": [
    "operator_id",
    "username",
    "display_name",
    "skill_level",
    "created_at"
  ],
  "additionalProperties": false
}
