{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.cat-operator-hub.example/v1/telemetry.schema.json",
  "title": "Telemetry",
  "type": "object",
  "properties": {
    "machine_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "operator_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "machine_model": {
      "const": "CAT 325"
    },
    "position": {
      "$ref": "common.schema.json#/$defs/point"
    },
    "heading_deg": {
      "$ref": "common.schema.json#/$defs/heading"
    },
    "speed_kmh": {
      "type": "number",
      "minimum": 0,
      "maximum": 20
    },
    "engine_running": {
      "type": "boolean"
    },
    "engine_hours": {
      "type": "number",
      "minimum": 0
    },
    "rpm": {
      "type": "number",
      "minimum": 0,
      "maximum": 5000
    },
    "throttle_percent": {
      "$ref": "common.schema.json#/$defs/percent"
    },
    "fuel_percent": {
      "anyOf": [
        {
          "$ref": "common.schema.json#/$defs/percent"
        },
        {
          "type": "null"
        }
      ]
    },
    "fuel_used_l_session": {
      "type": "number",
      "minimum": 0
    },
    "engine_temperature_c": {
      "anyOf": [
        {
          "type": "number",
          "minimum": -60,
          "maximum": 250
        },
        {
          "type": "null"
        }
      ]
    },
    "hydraulic_pressure_psi": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 0,
          "maximum": 10000
        },
        {
          "type": "null"
        }
      ]
    },
    "hydraulic_temperature_c": {
      "anyOf": [
        {
          "type": "number",
          "minimum": -60,
          "maximum": 250
        },
        {
          "type": "null"
        }
      ]
    },
    "load_percent": {
      "$ref": "common.schema.json#/$defs/percent"
    },
    "idle_time_s_session": {
      "type": "number",
      "minimum": 0
    },
    "load_cycles_session": {
      "type": "integer",
      "minimum": 0
    },
    "seatbelt_fastened": {
      "type": "boolean"
    },
    "operator_present": {
      "type": "boolean"
    },
    "parking_brake_engaged": {
      "type": "boolean"
    },
    "attachment": {
      "type": "object",
      "properties": {
        "type": {
          "const": "bucket"
        },
        "upper_body_heading_deg": {
          "$ref": "common.schema.json#/$defs/heading"
        },
        "boom_angle_deg": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        "stick_angle_deg": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        "bucket_angle_deg": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        "bucket_tip_position": {
          "$ref": "common.schema.json#/$defs/point"
        },
        "bucket_tip_height_m": {
          "type": "number"
        },
        "bucket_load_m3": {
          "type": "number",
          "minimum": 0
        },
        "footprint_radius_m": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 10
        },
        "arm_safety_radius_m": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 10
        }
      },
      "required": [
        "type",
        "upper_body_heading_deg",
        "boom_angle_deg",
        "stick_angle_deg",
        "bucket_angle_deg",
        "bucket_tip_position",
        "bucket_tip_height_m",
        "bucket_load_m3",
        "footprint_radius_m",
        "arm_safety_radius_m"
      ],
      "additionalProperties": false
    },
    "overridden_fields": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "rpm",
          "throttle_percent",
          "fuel_percent",
          "engine_temperature_c",
          "hydraulic_pressure_psi",
          "hydraulic_temperature_c",
          "load_percent"
        ]
      }
    },
    "extensions": {
      "$ref": "common.schema.json#/$defs/extensions"
    }
  },
  "required": [
    "machine_id",
    "operator_id",
    "machine_model",
    "position",
    "heading_deg",
    "speed_kmh",
    "engine_running",
    "engine_hours",
    "rpm",
    "throttle_percent",
    "fuel_percent",
    "fuel_used_l_session",
    "engine_temperature_c",
    "hydraulic_pressure_psi",
    "hydraulic_temperature_c",
    "load_percent",
    "idle_time_s_session",
    "load_cycles_session",
    "seatbelt_fastened",
    "operator_present",
    "parking_brake_engaged",
    "attachment",
    "overridden_fields"
  ],
  "additionalProperties": false
}
