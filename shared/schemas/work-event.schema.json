{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.cat-operator-hub.example/v1/work-event.schema.json",
  "title": "WorkEvent",
  "type": "object",
  "properties": {
    "event_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "task_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "kind": {
      "const": "material_deposited"
    },
    "destination_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "quantity_m3": {
      "type": "number",
      "minimum": 0.001
    },
    "simulation_time_s": {
      "type": "number",
      "minimum": 0
    }
  },
  "required": [
    "event_id",
    "task_id",
    "kind",
    "destination_id",
    "quantity_m3",
    "simulation_time_s"
  ],
  "additionalProperties": false
}
